# Optional Gemini action proposer. Leave blank for explicitly labeled rules mode.
# Choose a model enabled for your Google account; Flash Lite verified for this demo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional durable hosted synthetic sessions; BOTH values required.
# Secret key stays server-only. Never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Alternative to an administrative secret: publishable key + narrow server
# capability enabled by db/scoped-capability.sql. Never expose DEMO_KEY publicly.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DEMO_KEY=

# Default: local disk in .demo/; on Vercel without Supabase: ephemeral memory.
# Set memory only for tests or a clearly labeled ephemeral demonstration.
DEMO_STORAGE=
