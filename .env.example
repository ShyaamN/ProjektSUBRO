# All variables are optional in the synthetic sandbox. The platform remains fully
# operational without them and reports degraded modes openly via /api/status.

# Server-side LLM drafting (optional — deterministic drafting is used otherwise)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Supabase PostgreSQL persistence (optional — browser-persisted sandbox otherwise)
# Apply supabase/schema.sql first. Never expose a service-role key to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
